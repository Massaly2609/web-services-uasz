% ---------------------------------------------------------------- couleurs
\definecolor{Ink}{HTML}{0D1B2A}
\definecolor{Ink2}{HTML}{3D4F63}
\definecolor{Muted}{HTML}{778596}
\definecolor{Line}{HTML}{DBE2EA}
\definecolor{Paper}{HTML}{F4F7FA}
\definecolor{Teal}{HTML}{0F8A8F}
\definecolor{TealDark}{HTML}{0B6E72}
\definecolor{TealSoft}{HTML}{E0F2F2}
\definecolor{TealGlow}{HTML}{7FE0D8}
\definecolor{Amber}{HTML}{C96D07}
\definecolor{AmberLight}{HTML}{F2B45C}
\definecolor{AmberSoft}{HTML}{FDF0DC}
\definecolor{Rouge}{HTML}{C0392B}
\definecolor{RougeSoft}{HTML}{FBE8E6}
\definecolor{Vert}{HTML}{15804A}
\definecolor{VertSoft}{HTML}{E2F3E9}
\definecolor{Violet}{HTML}{6D5BD0}
\definecolor{VioletSoft}{HTML}{ECE9FB}
\definecolor{Navy}{HTML}{0B1620}
